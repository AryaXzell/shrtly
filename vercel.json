{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/|favicon\\.svg|app-icon\\.jpg|.*\\.[a-zA-Z0-9]+).*)",
      "destination": "/api"
    }
  ]
}
